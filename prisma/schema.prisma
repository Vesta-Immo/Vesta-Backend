generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String             @id @default(cuid())
  supabaseAuthUserId String             @unique
  propertyListState  PropertyListState?
  projects           Project[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Project {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  location  String?
  isImplicit Boolean   @default(false)
  scenarios Scenario[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@index([userId, isImplicit])
  @@map("projects")
}

model Scenario {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  inputParams  Json
  outputResult Json?
  isBaseline   Boolean   @default(false)
  computedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([projectId])
  @@map("scenarios")
}

model PropertyListState {
  id                String             @id @default(cuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  financingSettings Json?
  lastSimulation    Json?
  properties        PropertyListItem[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model PropertyListItem {
  id                    String                       @id
  stateId               String
  state                 PropertyListState            @relation(fields: [stateId], references: [id], onDelete: Cascade)
  status                PropertyTrackingStatus
  propertyType          PersistedPropertyType
  listingUrl            String?
  departmentCode        String?
  price                 Float
  addressOrSector       String
  propertyTaxAnnual     Float
  coOwnershipFeesAnnual Float
  renovationWorkItems   PropertyRenovationWorkItem[]
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
}

model PropertyRenovationWorkItem {
  id         String           @id @default(cuid())
  propertyId String
  property   PropertyListItem @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  position   Int
  name       String
  details    String?
  cost       Float
}

enum PropertyTrackingStatus {
  WANTED
  VISITED
}

enum PersistedPropertyType {
  NEW
  OLD
}

model PrixImmoDepartement {
  id               BigInt   @id @default(autoincrement())
  codeDepartement  String   @map("code_departement")
  nomDepartement   String   @map("nom_departement")
  typeBien         String   @map("type_bien")
  annee            Int
  prixMedianM2     Float    @map("prix_median_m2")
  nbTransactions   Int      @map("nb_transactions")
  evolution1anPct  Float?   @map("evolution_1an_pct")
  statut           String

  @@map("prix_immo_departement")
  @@index([codeDepartement, annee])
  @@index([typeBien, annee])
  @@unique([codeDepartement, typeBien, annee])
}

model PtzSimulation {
  id                  String   @id @default(cuid())
  propertyPrice       Int      // Prix du logement en centimes
  propertyZone        String   // Zone A, B1, B2, C
  householdSize       Int      // Nombre de personnes dans le foyer
  isPrimoAccedant     Boolean
  annualIncome        Int      // Revenu annuel en centimes
  workPercentage      Int      // % de travaux si ancien
  operationId         String?  // ID unique de l'opération pour vérification d'unicité
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  // Résultats
  isEligible          Boolean
  maxPtzAmount        Int
  ptzRate             Int      // Taux en basis points (0 pour PTZ)
  ptzDuration         Int      // Durée en mois
  
  @@map("ptz_simulations")
  @@index([operationId])
}