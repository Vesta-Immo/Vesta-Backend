generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String              @id @default(cuid())
  supabaseAuthUserId String              @unique
  propertyListState  PropertyListState?
  projects           Project[]
  financingProfiles  FinancingProfile[]
  preferences        UserPreferences?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Project {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  location  String?
  scenarios Scenario[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@map("projects")
}

model Scenario {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  inputParams  Json
  outputResult Json?
  isBaseline   Boolean   @default(false)
  computedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([projectId])
  @@map("scenarios")
}

model PropertyListState {
  id                String             @id @default(cuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  financingSettings Json?
  lastSimulation    Json?
  properties        PropertyListItem[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model PropertyListItem {
  id                    String                       @id
  stateId               String
  state                 PropertyListState            @relation(fields: [stateId], references: [id], onDelete: Cascade)
  status                PropertyTrackingStatus
  propertyType          PersistedPropertyType
  listingUrl            String?
  departmentCode        String?
  price                 Float
  addressOrSector       String
  propertyTaxAnnual     Float
  coOwnershipFeesAnnual Float
  renovationWorkItems   PropertyRenovationWorkItem[]
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
}

model PropertyRenovationWorkItem {
  id         String           @id @default(cuid())
  propertyId String
  property   PropertyListItem @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  position   Int
  name       String
  details    String?
  cost       Float
}

enum PropertyTrackingStatus {
  WANTED
  VISITED
}

enum PersistedPropertyType {
  NEW
  OLD
}

model FinancingProfile {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceScenarioId  String
  sourceProjectId   String

  // Données dénormalisées du scénario (JSONB)
  settings          Json

  // Métadonnées
  name              String
  description       String?
  isComplete        Boolean  @default(true)
  lastSyncedAt      DateTime @default(now())

  // Relation inverse pour le profil actif
  activeForUsers    UserPreferences[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([sourceScenarioId])
  @@index([sourceProjectId])
  @@map("financing_profiles")
}

model UserPreferences {
  id               String            @id @default(cuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Profil actif (nullable)
  activeProfileId  String?
  activeProfile    FinancingProfile? @relation(fields: [activeProfileId], references: [id], onDelete: SetNull)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId])
  @@index([activeProfileId])
  @@map("user_preferences")
}